<?xml version="1.0"?>
<!--
    Protheus OS - Genode System Configuration (init.config)

    Author:  m26steph@uwaterloo.ca
    Credits: Nicolae Carabut (Dispatch Labs) - architectural inspiration
    License: The Free License (https://github.com/codemodify/TheFreeLicense)

    Capability topology
    ───────────────────
    crypto_service  : LOG only — no network, no storage
    kv_store        : LOG, Timer — disk-backed, no network
    network_service : LOG, Timer, Nic — P2P only
    monerod         : Crypto, Kv_store, Nic (via network_service), Timer, LOG

    The strict <route> definitions below are the hardware-enforced
    isolation boundary.  network_service has NO route to crypto_service.
    Even a complete RCE in network_service leaves key material unreachable.
-->

<config verbose="no">

  <!-- ── Parent-provided services ───────────────────────────────────────── -->
  <parent-provides>
    <service name="ROM"/>
    <service name="RAM"/>
    <service name="IRQ"/>
    <service name="IO_MEM"/>
    <service name="IO_PORT"/>
    <service name="PD"/>
    <service name="RM"/>
    <service name="CPU"/>
    <service name="LOG"/>
    <service name="SIGNAL"/>
  </parent-provides>

  <!-- ── Default route (fallback to parent) ─────────────────────────────── -->
  <default-route>
    <any-service> <parent/> </any-service>
  </default-route>

  <!-- ══════════════════════════════════════════════════════════════════════
       Core platform services
       ══════════════════════════════════════════════════════════════════════ -->

  <!-- Timer service -->
  <start name="timer">
    <resource name="RAM"  quantum="1M"/>
    <resource name="CPU"  quantum="5"/>
    <provides><service name="Timer"/></provides>
    <route>
      <service name="LOG"><parent/></service>
      <service name="PD"> <parent/></service>
      <service name="CPU"><parent/></service>
      <service name="ROM"><parent/></service>
    </route>
  </start>

  <!-- Central logger - collects from all subsystems -->
  <start name="logger">
    <resource name="RAM"  quantum="10M"/>
    <resource name="CPU"  quantum="5"/>
    <provides><service name="LOG"/></provides>
    <config>
      <!-- Per-label rate limiting prevents log-flooding DoS -->
      <policy label_suffix="crypto_service"  rate_limit_kb="64"/>
      <policy label_suffix="kv_store"        rate_limit_kb="64"/>
      <policy label_suffix="network_service" rate_limit_kb="512"/>
      <policy label_suffix="monerod"         rate_limit_kb="1024"/>
    </config>
    <route>
      <service name="LOG"><parent/></service>
      <service name="PD"> <parent/></service>
      <service name="CPU"><parent/></service>
      <service name="ROM"><parent/></service>
    </route>
  </start>

  <!-- Platform driver - manages PCI, IRQ routing -->
  <start name="platform_drv" caps="200">
    <resource name="RAM"   quantum="50M"/>
    <resource name="CPU"   quantum="20"/>
    <provides>
      <service name="Platform"/>
      <service name="Acpi"/>
    </provides>
    <route>
      <service name="LOG">  <child name="logger"/></service>
      <service name="Timer"><child name="timer"/> </service>
      <service name="IO_MEM">  <parent/></service>
      <service name="IO_PORT"> <parent/></service>
      <service name="IRQ">     <parent/></service>
      <service name="PD">      <parent/></service>
      <service name="CPU">     <parent/></service>
      <service name="ROM">     <parent/></service>
    </route>
  </start>

  <!-- ══════════════════════════════════════════════════════════════════════
       Storage layer
       ══════════════════════════════════════════════════════════════════════ -->

  <!-- Block device driver (VirtIO or AHCI) -->
  <start name="block_drv" caps="100">
    <resource name="RAM"  quantum="20M"/>
    <resource name="CPU"  quantum="10"/>
    <provides><service name="Block"/></provides>
    <route>
      <service name="Platform"><child name="platform_drv"/></service>
      <service name="LOG">     <child name="logger"/>      </service>
      <service name="Timer">   <child name="timer"/>       </service>
      <service name="IO_MEM">  <parent/></service>
      <service name="IRQ">     <parent/></service>
      <service name="PD">      <parent/></service>
      <service name="CPU">     <parent/></service>
      <service name="ROM">     <parent/></service>
    </route>
  </start>

  <!-- VFS server - unified virtual filesystem for all services -->
  <start name="vfs_server" caps="150">
    <resource name="RAM"  quantum="128M"/>
    <resource name="CPU"  quantum="20"/>
    <provides><service name="File_system"/></provides>
    <config>
      <vfs>
        <dir name="dev">
          <log/>
          <null/>
          <zero/>
          <rtc/>
        </dir>
        <dir name="proc">
          <proc/>
        </dir>
        <dir name="db">
          <!-- LMDB-backed databases live here -->
          <dir name="blockchain"/>
          <dir name="transactions"/>
          <dir name="accounts"/>
          <dir name="metadata"/>
        </dir>
        <dir name="tmp">
          <!-- In-memory RAM FS for ephemeral data -->
          <ram/>
        </dir>
        <dir name="log">
          <log/>
        </dir>
      </vfs>
      <!-- Per-component access policies -->
      <policy label="kv_store"   root="/db"  writeable="yes"/>
      <policy label="monerod"    root="/"    writeable="no"/>
      <policy label="logger"     root="/log" writeable="yes"/>
    </config>
    <route>
      <service name="Block"><child name="block_drv"/></service>
      <service name="LOG">  <child name="logger"/>   </service>
      <service name="Timer"><child name="timer"/>    </service>
      <service name="PD">   <parent/></service>
      <service name="CPU">  <parent/></service>
      <service name="ROM">  <parent/></service>
    </route>
  </start>

  <!-- ══════════════════════════════════════════════════════════════════════
       Network layer (FULLY ISOLATED from crypto)
       ══════════════════════════════════════════════════════════════════════ -->

  <!-- NIC driver (Intel e1000 / VirtIO net) -->
  <start name="nic_drv" caps="100">
    <resource name="RAM"  quantum="50M"/>
    <resource name="CPU"  quantum="15"/>
    <provides><service name="Nic"/></provides>
    <route>
      <service name="Platform"><child name="platform_drv"/></service>
      <service name="LOG">     <child name="logger"/>      </service>
      <service name="Timer">   <child name="timer"/>       </service>
      <service name="IO_MEM">  <parent/></service>
      <service name="IRQ">     <parent/></service>
      <service name="PD">      <parent/></service>
      <service name="CPU">     <parent/></service>
      <service name="ROM">     <parent/></service>
    </route>
  </start>

  <!-- NIC bridge - multiplexes the physical NIC across components -->
  <start name="nic_bridge" caps="100">
    <resource name="RAM"  quantum="20M"/>
    <resource name="CPU"  quantum="10"/>
    <provides><service name="Nic"/></provides>
    <route>
      <service name="Nic"><child name="nic_drv"/></service>
      <service name="LOG"><child name="logger"/> </service>
      <service name="PD"> <parent/></service>
      <service name="CPU"><parent/></service>
      <service name="ROM"><parent/></service>
    </route>
  </start>

  <!-- ══════════════════════════════════════════════════════════════════════
       Protheus services
       ══════════════════════════════════════════════════════════════════════ -->

  <!--
    CRYPTO SERVICE
    ─────────────
    Capability boundary: LOG only.
    ZERO network route.  ZERO storage write route.
    Private key lives in this component's RAM.
    Hardware MMU prevents any other process from mapping this memory.
  -->
  <start name="crypto_service" caps="150">
    <resource name="RAM"  quantum="256M"/>
    <resource name="CPU"  quantum="50"/>
    <provides><service name="Crypto"/></provides>
    <config>
      <!-- Key derivation parameters (seed sourced from secure hardware in prod) -->
      <key-params algorithm="ed25519" seed-source="firmware-tpm"/>
      <!-- libsodium compile-time options -->
      <libsodium hardware-aes-ni="true" hardware-avx2="true"/>
    </config>
    <route>
      <!-- Strictly limited to system services only — NO Nic, NO File_system -->
      <service name="LOG">  <child name="logger"/></service>
      <service name="Timer"><child name="timer"/> </service>
      <service name="PD">   <parent/></service>
      <service name="CPU">  <parent/></service>
      <service name="ROM">  <parent/></service>
      <service name="RAM">  <parent/></service>
    </route>
  </start>

  <!--
    KEY-VALUE STORE (kv_store / LMDB)
    ──────────────────────────────────
    Capability boundary: LOG, Timer, File_system (db partition only).
    NO Nic route.  Cannot communicate with crypto_service directly.
    Manages off-chain artifacts as described in the Dispatch Labs model:
    structured data, BLOBs, and transaction history.
  -->
  <start name="kv_store" caps="150">
    <resource name="RAM"  quantum="2G"/>
    <resource name="CPU"  quantum="100"/>
    <provides><service name="Kv_store"/></provides>
    <config>
      <lmdb>
        <map-size-gb>100</map-size-gb>
        <max-readers>128</max-readers>
        <max-dbs>32</max-dbs>
        <databases>
          <db name="blockchain"    flags="dupsort"/>
          <db name="transactions"  flags="integerkey"/>
          <db name="accounts"      flags="dupsort"/>
          <db name="metadata"      flags=""/>
        </databases>
        <batch-writes enabled="true" batch-size="10000"/>
      </lmdb>
    </config>
    <route>
      <service name="File_system"><child name="vfs_server"/> </service>
      <service name="LOG">        <child name="logger"/>     </service>
      <service name="Timer">      <child name="timer"/>      </service>
      <!-- NO Nic.  NO Crypto.  Storage only. -->
      <service name="PD">  <parent/></service>
      <service name="CPU"> <parent/></service>
      <service name="ROM"> <parent/></service>
      <service name="RAM"> <parent/></service>
    </route>
  </start>

  <!--
    NETWORK SERVICE (P2P)
    ──────────────────────
    Capability boundary: LOG, Timer, Nic.
    NO crypto_service route.  NO kv_store route.
    Exposes raw P2P framing to monerod — it never interprets semantics.
    This is the highest-attack-surface component; its isolation is critical.
  -->
  <start name="network_service" caps="150">
    <resource name="RAM"  quantum="512M"/>
    <resource name="CPU"  quantum="100"/>
    <provides><service name="Network"/></provides>
    <config>
      <p2p>
        <listen-port>18080</listen-port>
        <bind-address>0.0.0.0</bind-address>
        <max-peers>32</max-peers>
        <peer-timeout-sec>300</peer-timeout-sec>
        <max-ban-score>100</max-ban-score>
        <seed-nodes>
          <node host="seeds.moneroseeds.se"  port="18080"/>
          <node host="seeds.moneroseeds.se2" port="18080"/>
          <node host="node.community.rino.io" port="18081"/>
        </seed-nodes>
      </p2p>
      <ddos-protection enabled="true" max-connections-per-ip="3"/>
    </config>
    <route>
      <!-- Has Nic.  Does NOT have Crypto or Kv_store routes. -->
      <service name="Nic">  <child name="nic_bridge"/></service>
      <service name="LOG">  <child name="logger"/>    </service>
      <service name="Timer"><child name="timer"/>     </service>
      <service name="PD">   <parent/></service>
      <service name="CPU">  <parent/></service>
      <service name="ROM">  <parent/></service>
      <service name="RAM">  <parent/></service>
    </route>
  </start>

  <!--
    MONERO DAEMON (monerod) — orchestrator
    ───────────────────────────────────────
    The only process with routes to ALL three services.
    Holds no keys itself; delegates all crypto to crypto_service.
    Validates consensus and drives the block-processing pipeline.
  -->
  <start name="monerod" caps="250">
    <resource name="RAM"  quantum="4G"/>
    <resource name="CPU"  quantum="200"/>
    <config>
      <libc>
        <vfs>
          <dir name="dev"><log/><null/><zero/></dir>
          <dir name="proc"><proc/></dir>
        </vfs>
      </libc>
      <blockchain>
        <network>mainnet</network>
        <sync-mode>full</sync-mode>
        <verify-signatures>true</verify-signatures>
        <prune-mode>disabled</prune-mode>
        <checkpoints enabled="true"/>
      </blockchain>
      <p2p>
        <port>18080</port>
        <bind-interface>0.0.0.0</bind-interface>
        <max-peers>32</max-peers>
        <no-igd>false</no-igd>
      </p2p>
      <rpc>
        <port>18081</port>
        <bind-interface>127.0.0.1</bind-interface>
        <restricted-rpc>true</restricted-rpc>
        <max-clients>10</max-clients>
      </rpc>
      <logging>
        <level>info</level>
        <output>/dev/log</output>
      </logging>
    </config>
    <route>
      <!-- Full set of service routes for the orchestrator -->
      <service name="Crypto">       <child name="crypto_service"/>  </service>
      <service name="Kv_store">     <child name="kv_store"/>        </service>
      <service name="Network">      <child name="network_service"/> </service>
      <service name="File_system">  <child name="vfs_server"/>      </service>
      <service name="LOG">          <child name="logger"/>          </service>
      <service name="Timer">        <child name="timer"/>           </service>
      <service name="ROM" label_suffix="config"><parent label="config"/></service>
      <service name="ROM">          <parent/></service>
      <service name="PD">           <parent/></service>
      <service name="CPU">          <parent/></service>
      <service name="RAM">          <parent/></service>
      <service name="RM">           <parent/></service>
    </route>
  </start>

  <!-- ══════════════════════════════════════════════════════════════════════
       Optional: RPC gateway (restricted external interface)
       ══════════════════════════════════════════════════════════════════════ -->
  <start name="rpc_gateway" caps="100">
    <resource name="RAM"  quantum="256M"/>
    <resource name="CPU"  quantum="50"/>
    <config>
      <rpc>
        <listen-address>127.0.0.1</listen-address>
        <listen-port>18081</listen-port>
        <max-clients>10</max-clients>
        <rate-limit-rpm>60</rate-limit-rpm>
      </rpc>
    </config>
    <route>
      <service name="Nic">  <child name="nic_bridge"/></service>
      <service name="LOG">  <child name="logger"/>    </service>
      <service name="Timer"><child name="timer"/>     </service>
      <service name="PD">   <parent/></service>
      <service name="CPU">  <parent/></service>
      <service name="ROM">  <parent/></service>
    </route>
  </start>

</config>
